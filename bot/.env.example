# Store real values in bot/.env on the worker host. Never use NEXT_PUBLIC_ for secrets.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_EXPECTED_USERNAME=NFL_TieWon

# Preview only until explicitly enabled on the host.
BOT_LIVE=false
BOT_POLL_SECONDS=30
BOT_MIN_PROBABILITY=0.15
BOT_MIN_CHANGE=0.10
BOT_COOLDOWN_SECONDS=180
BOT_MAX_POSTS_PER_GAME=6
BOT_MAX_POSTS_PER_DAY=50
# Optional. Live and dry-run use distinct databases by default.
# BOT_DATABASE=/absolute/path/to/live.sqlite
