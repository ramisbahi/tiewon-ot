# Store real values in bot/.env on the worker host. Never use NEXT_PUBLIC_ for secrets.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_EXPECTED_USERNAME=NFL_TieWon

# Dry-run until enabled on the host.
BOT_LIVE=false
BOT_POLL_SECONDS=15
BOT_MAX_FORECASTS_PER_DAY=128
BOT_OVERTIME_RUNS=10000
# Optional. Live and dry-run use distinct databases by default.
# BOT_DATABASE=/absolute/path/to/live.sqlite

# Shared website history. Use the same secret as HISTORY_INGEST_SECRET on Sites.
# BOT_HISTORY_URL=https://tiewon.sbahirami.chatgpt.site/api/history/ingest
# BOT_HISTORY_TOKEN=
